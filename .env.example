# Copia este archivo como .env y completa los valores. El archivo .env no se sube a Git.

# --- Obligatorias ---
# Clave para firmar sesiones y códigos. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Si la cambias, se cierran las sesiones y los códigos pendientes dejan de servir.
SECRET_KEY=

# IA (Groq): chat, recomendaciones y lectura de convocatorias.
GROQ_API_KEY=
# Si Groq retira un modelo (error 404), actualiza estos nombres en console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_RESPALDO=openai/gpt-oss-20b

# --- Base de datos ---
# Vacío: SQLite local (datos/focu.db), solo para desarrollo.
# En producción, la cadena de PostgreSQL: postgresql://usuario:clave@host/base?sslmode=require
DATABASE_URL=

# --- Primer administrador ---
# Se crea al arrancar solo si aún no hay ninguno.
ADMIN_CORREO=
ADMIN_NOMBRE=Director VRI

# --- Correo (código de acceso y avisos) ---
# Opción A: Brevo (API).
BREVO_API_KEY=
# Opción B: servidor SMTP institucional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente, obligatorio con A o B. Sin ninguna de las dos, los correos se imprimen en la consola.
MAIL_FROM=

# --- Opcionales ---
# Porcentaje de afinidad: auto | gemini | local | none
EMBEDDINGS_PROVIDER=auto
GEMINI_API_KEY=
# Horas entre recolecciones automáticas de convocatorias (0: solo con el botón).
SCRAPER_CADA_HORAS=0